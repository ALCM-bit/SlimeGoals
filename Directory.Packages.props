<Project>
  <PropertyGroup>
    <!-- Os seis pacotes do Avalonia na mesma versão. O Dependabot só enxerga os do SlimeGoals.slnx (o Android precisa
         do workload e a Render está fora das soluções); atualizando um deles, ele troca esta propriedade e os seis
         seguem juntos. -->
    <AvaloniaVersion>12.2.0</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <!-- Head Android (src/SlimeGoals.Android) -->
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
    <!-- Ferramenta de renderização (tools/SlimeGoals.Render) -->
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <!-- Dados -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <!-- Servidor -->
    <PackageVersion Include="Npgsql" Version="11.0.0" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <!-- Plataforma Linux -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.2" />
    <!-- Cripto da sincronização (src/SlimeGoals.Sync) -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- Testes -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
  </ItemGroup>
</Project>
