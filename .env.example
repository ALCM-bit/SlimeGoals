# O packaging/server/init-env.sh cria o .env e os segredos em secrets/. Para fazer o .env à mão, copie este
# arquivo para .env e preencha. Aqui só entra o que não é segredo: senhas, strings de conexão, o segredo do
# prelogin e o convite ficam em secrets/, um arquivo por chave. O .env e o secrets/ ficam fora do repositório.

# Domínio do servidor. O Caddy tira o certificado do Let's Encrypt para ele; com localhost, usa a CA interna.
SLIMEGOALS_DOMAIN=localhost
# Opcional: e-mail de contato da conta ACME do Let's Encrypt.
ACME_EMAIL=

# SMTP do e-mail de confirmação (obrigatório em produção). A senha vai em secrets/Email__Smtp__Password.
# Exemplo com o Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USERNAME=resend.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
# Remetente, com ou sem nome: SlimeGoals <nao-responda@exemplo.com>
SMTP_FROM=

# Opcional: portas do host para o Caddy (padrão 80 e 443). O compose.tailnet.yaml ignora as duas (só TAILNET_IP:443).
# HTTP_PORT=80
# HTTPS_PORT=443

# Na tailnet (compose.tailnet.yaml): o Caddy publica só neste IP, na 443, com o certificado lido de arquivos.
# SLIMEGOALS_DOMAIN passa a ser o nome .ts.net completo da VM (também vai para AllowedHosts). Valores de exemplo:
# TAILNET_IP=100.64.0.10
# Pasta com tailnet.crt e tailnet.key, montada somente leitura no Caddy.
# TAILNET_CERT_DIR=/etc/slimegoals/tls
