# O packaging/server/init-env.sh cria o .env com segredos aleatórios. Para fazer à mão, copie este arquivo
# para .env e preencha. O .env fica fora do repositório.
# Senha do usuário slimegoals no PostgreSQL local.
POSTGRES_PASSWORD=
# Segredo do sal falso do prelogin (ex.: openssl rand -hex 32).
SERVER_PRELOGIN_SECRET=
