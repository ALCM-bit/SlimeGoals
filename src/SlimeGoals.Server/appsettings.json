{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=slimegoals;Username=slimegoals;Password=slimegoals"
  },
  "Server": {
    "PreloginSecret": "",
    "DefaultKdfParams": "{\"v\":1,\"m\":65536,\"t\":3,\"p\":1}",
    "MigrateOnStart": true
  },
  "Sync": {
    "DefaultLimit": 200,
    "MaxLimit": 500,
    "MaxRecordsPerAccount": null
  },
  "Limits": {
    "MaxBatchItems": 100,
    "MaxBlobBytes": 65536,
    "MaxBodyBytes": 10485760,
    "AuthPerIpPerMinute": 20,
    "AuthPerEmailPerMinute": 10
  },
  "Retention": {
    "TombstoneDays": 180,
    "UnconfirmedAccountHours": 24
  },
  "Maintenance": {
    "Enabled": true
  }
}
