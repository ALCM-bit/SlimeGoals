{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "PreloginSecret": "",
    "DefaultKdfParams": "{\"v\":1,\"m\":65536,\"t\":3,\"p\":1}",
    "MigrateOnStart": true,
    "TrustedProxyNetworks": [],
    "InviteCode": ""
  },
  "Sync": {
    "DefaultLimit": 200,
    "MaxLimit": 500,
    "MaxRecordsPerAccount": 100000
  },
  "Limits": {
    "MaxBatchItems": 100,
    "MaxBlobBytes": 65536,
    "MaxBodyBytes": 10485760,
    "AuthPerIpPerMinute": 20,
    "AuthPerEmailPerIpPerMinute": 10,
    "LoginFailuresPerEmailPerHour": 50,
    "ConfirmationEmailsPerAddressPerHour": 3,
    "AuthKeyFailuresPerAccountPerMinute": 10,
    "RequestsPerIpPerMinute": 600,
    "SyncPerDevicePerMinute": 300
  },
  "Retention": {
    "TombstoneDays": 180,
    "UnconfirmedAccountHours": 24,
    "DeviceIdleDays": 30
  },
  "Maintenance": {
    "Enabled": true
  },
  "Email": {
    "Mode": "log",
    "RetryDelaySeconds": [ 2, 10 ],
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "From": "",
      "Security": "StartTls"
    }
  }
}
