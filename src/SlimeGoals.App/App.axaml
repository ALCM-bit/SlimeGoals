<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             xmlns:views="using:SlimeGoals.App.Views"
             xmlns:conv="using:SlimeGoals.App.Converters"
             x:Class="SlimeGoals.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SlimeGoals.App/Styles/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:IconKeyToGeometryConverter x:Key="IconGeometry" />
      <conv:GoalColorToBrushConverter x:Key="GoalColorBrush" />
    </ResourceDictionary>
  </Application.Resources>

  <!-- Uma View por tipo de página, sem ViewLocator por reflexão (bindings compilados) -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:TodayPageViewModel"><views:TodayView /></DataTemplate>
    <DataTemplate DataType="vm:GoalsPageViewModel"><views:GoalsView /></DataTemplate>
    <DataTemplate DataType="vm:ReportsPageViewModel"><views:ReportsView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsPageViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:GoalEditViewModel"><views:GoalEditView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SlimeGoals.App/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
