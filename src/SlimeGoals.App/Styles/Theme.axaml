<!--
  Tokens do design system (spec §11). Use sempre via DynamicResource.
  Nomes em PascalCase espelham os tokens da spec (bg → Bg, surface-2 → Surface2...).
  Para cada cor há a Color (sufixo Color) e o Brush (sem sufixo).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Cores base -->
  <Color x:Key="BgColor">#0F0D15</Color>
  <Color x:Key="BgDeepColor">#0C0A11</Color>
  <Color x:Key="PanelColor">#15121C</Color>
  <Color x:Key="SurfaceColor">#17141F</Color>
  <Color x:Key="TileColor">#1A1722</Color>
  <Color x:Key="Surface2Color">#1F1B2B</Color>
  <Color x:Key="BorderColor">#2A2538</Color>
  <Color x:Key="TextColor">#E8E4F0</Color>
  <Color x:Key="MutedColor">#A39DB8</Color>
  <Color x:Key="PrimaryColor">#9B7BEA</Color>
  <Color x:Key="PrimarySoftColor">#B9A3F0</Color>
  <Color x:Key="PrimaryTintColor">#D6C8FA</Color>
  <Color x:Key="SelectedColor">#2A2145</Color>
  <Color x:Key="SelectedStrongColor">#3A2F63</Color>
  <Color x:Key="BarIdleColor">#3A3350</Color>
  <Color x:Key="OnPrimaryColor">#14101D</Color>
  <Color x:Key="SuccessColor">#7FD1AE</Color>
  <Color x:Key="WarningColor">#E8B86D</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="BgDeep" Color="{StaticResource BgDeepColor}" />
  <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="Tile" Color="{StaticResource TileColor}" />
  <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
  <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="Primary" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimarySoft" Color="{StaticResource PrimarySoftColor}" />
  <SolidColorBrush x:Key="PrimaryTint" Color="{StaticResource PrimaryTintColor}" />
  <SolidColorBrush x:Key="Selected" Color="{StaticResource SelectedColor}" />
  <SolidColorBrush x:Key="SelectedStrong" Color="{StaticResource SelectedStrongColor}" />
  <SolidColorBrush x:Key="BarIdle" Color="{StaticResource BarIdleColor}" />
  <SolidColorBrush x:Key="OnPrimary" Color="{StaticResource OnPrimaryColor}" />
  <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />

  <!-- Cartão de destaque (hero): gradiente 145° -->
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#7656D0" />
    <GradientStop Offset="1" Color="#43347F" />
  </LinearGradientBrush>

  <!-- Paleta de metas (campo goals.color): fundo suave + ícone -->
  <SolidColorBrush x:Key="GoalPurpleBg" Color="#2A2145" />
  <SolidColorBrush x:Key="GoalPurpleFg" Color="#B9A3F0" />
  <SolidColorBrush x:Key="GoalPinkBg" Color="#3A2133" />
  <SolidColorBrush x:Key="GoalPinkFg" Color="#F0A3C4" />
  <SolidColorBrush x:Key="GoalAmberBg" Color="#382E1A" />
  <SolidColorBrush x:Key="GoalAmberFg" Color="#E8B86D" />
  <SolidColorBrush x:Key="GoalGreenBg" Color="#1E3B33" />
  <SolidColorBrush x:Key="GoalGreenFg" Color="#7FD1AE" />

  <!-- Forma -->
  <CornerRadius x:Key="RadiusControl">14</CornerRadius>
  <CornerRadius x:Key="RadiusCard">22</CornerRadius>

  <!-- Tipografia: Figtree embutida (OFL) -->
  <FontFamily x:Key="FigtreeFont">avares://SlimeGoals.App/Assets/Fonts#Figtree</FontFamily>

  <!-- Ícones dos botões de ação (Lucide, ISC; grade 24×24, só traço). Use com Path.btn-icon. -->
  <StreamGeometry x:Key="IconCheck">M 20 6 L 9 17 L 4 12</StreamGeometry>
  <StreamGeometry x:Key="IconX">M 18 6 L 6 18 M 6 6 L 18 18</StreamGeometry>
  <StreamGeometry x:Key="IconChevronLeft">M 15 18 L 9 12 L 15 6</StreamGeometry>
  <StreamGeometry x:Key="IconChevronRight">M 9 18 L 15 12 L 9 6</StreamGeometry>
  <StreamGeometry x:Key="IconMinus">M 5 12 L 19 12</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M 5 12 L 19 12 M 12 5 L 12 19</StreamGeometry>
  <StreamGeometry x:Key="IconPlay">M 6 3 L 20 12 L 6 21 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStop">M 5 3 L 19 3 A 2 2 0 0 1 21 5 L 21 19 A 2 2 0 0 1 19 21 L 5 21 A 2 2 0 0 1 3 19 L 3 5 A 2 2 0 0 1 5 3 Z</StreamGeometry>
  <StreamGeometry x:Key="IconEllipsis">M 5 12 L 5.01 12 M 12 12 L 12.01 12 M 19 12 L 19.01 12</StreamGeometry>
</ResourceDictionary>
