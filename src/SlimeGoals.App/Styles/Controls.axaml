<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SlimeGoals.App.Views">

  <!-- Fonte e cores padrão da janela; no Android não há Window, e a raiz é a ShellView ou a tela de erro -->
  <Style Selector="Window, views|ShellView, views|StartupFailureView">
    <Setter Property="FontFamily" Value="{DynamicResource FigtreeFont}" />
    <Setter Property="Background" Value="{DynamicResource BgDeep}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- O contorno de foco padrão do Fluent é um retângulo que ignora os cantos arredondados.
       Cada controle focável mostra o próprio foco, no formato dele (estilos :focus-visible). -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <!-- Rolagem das páginas: a barra fica na borda da janela, longe do conteúdo. A margem direita do
       shell-body passa para a DockPanel.page, e só a rolagem avança sobre ela; a margem negativa e o
       Padding se compensam, e o conteúdo mantém a largura. A margem negativa precisa ficar dentro da
       view: os controles com template cortam o que passa dos seus limites, e a barra sumiria. -->
  <Style Selector="ScrollViewer.page">
    <Setter Property="Margin" Value="0,0,-22,0" />
    <Setter Property="Padding" Value="0,0,22,0" />
  </Style>

  <!-- Painel (barra lateral do bento v4) -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
  </Style>

  <!-- Título de página -->
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Navegação lateral: ListBox com itens de 44px, raio 14 -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Selected}" />
    <Setter Property="Foreground" Value="{DynamicResource NavSelectedText}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ===== Fase 7a: shell adaptativo. Largo = barra lateral; classe compact (ShellView < 720px) =
       navegação inferior, margens menores e os ajustes de cada tela (fim deste arquivo). ===== -->
  <Style Selector="DockPanel.shell-body">
    <Setter Property="Margin" Value="14,14,0,14" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Width" Value="220" />
    <Setter Property="Margin" Value="0,0,14,0" />
  </Style>
  <Style Selector="Border.bottom-nav">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="4,6" />
  </Style>
  <Style Selector="ListBox.bottom-nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.bottom-nav ListBoxItem">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <!-- Sem o fundo de item do Fluent: o destaque é só a pílula atrás do ícone -->
  <Style Selector="ListBox.bottom-nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector="ListBox.bottom-nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.bottom-nav ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.bottom-nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.bottom-nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="ListBox.bottom-nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.bottom-nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource PrimarySoft}" />
  </Style>
  <Style Selector="ListBox.bottom-nav ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.nav-pill">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.bottom-nav ListBoxItem:pointerover Border.nav-pill">
    <Setter Property="Background" Value="{DynamicResource NavHover}" />
  </Style>
  <Style Selector="ListBox.bottom-nav ListBoxItem:selected Border.nav-pill">
    <Setter Property="Background" Value="{DynamicResource Selected}" />
  </Style>
  <Style Selector="Path.nav-icon">
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
  </Style>
  <Style Selector="TextBlock.nav-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.bottom-nav ListBoxItem:selected TextBlock.nav-label">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ===== Fase 2: componentes das telas de metas (tokens da spec §11) ===== -->

  <!-- Aviso da confirmação de exclusão: quebra em duas linhas, dentro de painéis horizontais que dão largura infinita -->
  <Style Selector="TextBlock.delete-warning">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="240" />
  </Style>
  <Style Selector="StackPanel.delete-actions">
    <Setter Property="Orientation" Value="Horizontal" />
  </Style>

  <!-- Botões: primário (ação principal), fantasma (secundária), perigo (excluir) -->
  <Style Selector="Button.primary, Button.ghost, Button.danger, Button.danger-solid">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Selected}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.back">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="Button.danger-solid">
    <Setter Property="Background" Value="{DynamicResource Warning}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Cartão de meta (tile do bento v4) e quadrado do ícone -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Tile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="Border.icon-tile">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector="Path.goal-icon">
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <!-- Faixa de aviso -->
  <Style Selector="Border.warning-band">
    <Setter Property="Background" Value="{DynamicResource GoalAmberBg}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.warning-band TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>

  <!-- Segmento (Ativas | Arquivadas, Diária | Semanal) -->
  <Style Selector="Border.segment">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="18,0" MinHeight="40"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Background" Value="{DynamicResource SelectedStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.segment:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Campos do formulário -->
  <Style Selector="StackPanel.field">
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.field-error">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="TextBox, NumericUpDown, ComboBox, TimePicker, CalendarDatePicker">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <!-- Texto centralizado na vertical (a altura mínima de 44 deixava o conteúdo no topo) -->
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- Os botões do NumericUpDown são retos: sem o recorte, os cantos vazam do campo arredondado -->
  <Style Selector="ButtonSpinner /template/ Border">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ToggleSwitch:focus-visible /template/ Border#OuterBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- O TimePicker não repassa VerticalContentAlignment: os TextBlocks de hora e minuto esticam e o texto fica no topo -->
  <Style Selector="TimePicker /template/ TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Seletor de ícones e de cores: ListBox em grade, item selecionado com anel PrimarySoft -->
  <Style Selector="ListBox.icon-picker, ListBox.color-picker">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.icon-picker ListBoxItem">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.color-picker ListBoxItem">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.icon-picker ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector="ListBox.color-picker ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>
  <Style Selector="ListBox.icon-picker ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.color-picker ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Selected}" />
  </Style>
  <Style Selector="ListBox.icon-picker ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.color-picker ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ListBox.icon-picker ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ListBox.color-picker ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Dias da semana: botões circulares de 44px -->
  <Style Selector="ToggleButton.day">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.day:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="ToggleButton.day:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="ToggleButton.day:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoft}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- Tela Hoje (Fase 3): resumo, cartões, barra de progresso, painel inline -->
  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{DynamicResource Tile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="TextBlock.stat-label">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.stat-value">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.stat-unit">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <Style Selector="Border.hero">
    <Setter Property="Background" Value="{DynamicResource HeroBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    <Setter Property="Padding" Value="22" />
    <Setter Property="MinHeight" Value="170" />
  </Style>
  <Style Selector="TextBlock.hero-label">
    <Setter Property="Foreground" Value="{DynamicResource HeroMuted}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.hero-value">
    <Setter Property="Foreground" Value="{DynamicResource HeroText}" />
    <Setter Property="FontSize" Value="56" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="TextBlock.hero-unit">
    <Setter Property="Foreground" Value="{DynamicResource HeroText}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="ProgressBar.hero">
    <Setter Property="Width" Value="170" />
    <Setter Property="MinHeight" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource HeroTrack}" />
    <Setter Property="Foreground" Value="{DynamicResource HeroText}" />
  </Style>
  <Style Selector="views|SlimeMascot.hero-slime">
    <Setter Property="Width" Value="130" />
    <Setter Property="Height" Value="130" />
  </Style>
  <Style Selector="Border.hero-bubble">
    <Setter Property="Background" Value="{DynamicResource HeroBubble}" />
    <Setter Property="CornerRadius" Value="14,14,4,14" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.card.today.met">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="ProgressBar.goal">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource BarIdle}" />
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="18" />
  </Style>
  <!-- Ícone vetorial dentro de Button.icon: grade 24×24 sem esticar (proporções do Lucide), reduzida a ~20 px;
       traço na cor do texto do botão (acompanha hover e desabilitado) -->
  <Style Selector="Path.btn-icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="RenderTransform" Value="scale(0.85)" />
    <Setter Property="StrokeThickness" Value="2.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
  </Style>
  <Style Selector="Border.inline-panel">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.bar">
    <Setter Property="Width" Value="30" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="{DynamicResource BarIdle}" />
  </Style>
  <Style Selector="Border.bar.selected">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
  </Style>
  <!-- Coluna clicável de uma barra do relatório: sem fundo, ocupa a célula inteira -->
  <Style Selector="Button.bar-hit">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector="Button.bar-hit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <Style Selector="Button.bar-hit:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Selected}" />
  </Style>
  <Style Selector="Border.icon-tile.small">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <!-- ✓ de meta cumprida no detalhe da barra -->
  <Style Selector="Path.met-icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="RenderTransform" Value="scale(0.8)" />
    <Setter Property="StrokeThickness" Value="2.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource Success}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.bar-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.bar-label.current, TextBlock.bar-label.selected">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="TextBlock.bar-label.selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource BarIdle}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tag TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <!-- Classes das telas que o layout estreito ajusta; aqui, os valores do layout largo -->
  <Style Selector="DockPanel.page">
    <Setter Property="Margin" Value="8,4,22,0" />
  </Style>
  <Style Selector="UniformGrid.tiles">
    <Setter Property="Columns" Value="3" />
    <Setter Property="ColumnSpacing" Value="12" />
    <Setter Property="RowSpacing" Value="12" />
  </Style>
  <Style Selector="UniformGrid.report-tiles">
    <Setter Property="Columns" Value="2" />
    <Setter Property="ColumnSpacing" Value="12" />
    <Setter Property="RowSpacing" Value="12" />
  </Style>
  <!-- "N disparados · N atendidos" não cabe numa linha em janelas menores -->
  <Style Selector="UniformGrid.report-tiles TextBlock.stat-value">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Coluna e linha por estilo (valor local venceria o do layout estreito) -->
  <Style Selector="StackPanel.card-actions">
    <Setter Property="Grid.Column" Value="2" />
  </Style>
  <Style Selector="Border.report-mode">
    <Setter Property="Grid.Column" Value="1" />
  </Style>
  <!-- Campos lado a lado do formulário (Orientation só por estilo: valor local venceria o do layout estreito) -->
  <Style Selector="StackPanel.field-row">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="10" />
  </Style>
  <Style Selector="StackPanel.goal-form">
    <Setter Property="Width" Value="640" />
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="ContentControl.goal-actions.docked">
    <Setter Property="Width" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,12,0,14" />
  </Style>
  <Style Selector="ContentControl.goal-actions.inline">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Margin" Value="0,24,0,6" />
  </Style>
  <!-- Enter salva pela barra visível (a fixa, no layout largo) -->
  <Style Selector="ContentControl.goal-actions.docked Button.save">
    <Setter Property="IsDefault" Value="True" />
  </Style>
  <Style Selector="StackPanel.settings-list">
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- ===== Layout estreito (Fase 7a): tudo abaixo vale só sob a classe compact (ShellView < 720px) ===== -->
  <Style Selector=".compact Border.bottom-nav">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=".compact Border.sidebar">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".compact DockPanel.shell-body">
    <Setter Property="Margin" Value="12,12,0,12" />
  </Style>
  <Style Selector=".compact DockPanel.page">
    <Setter Property="Margin" Value="0,4,12,0" />
  </Style>
  <Style Selector=".compact ScrollViewer.page">
    <Setter Property="Margin" Value="0,0,-12,0" />
    <Setter Property="Padding" Value="0,0,12,0" />
  </Style>
  <Style Selector=".compact TextBlock.page-title">
    <Setter Property="FontSize" Value="22" />
  </Style>
  <!-- Hoje: cartão de destaque e tiles mais compactos -->
  <Style Selector=".compact Border.hero">
    <Setter Property="Padding" Value="16" />
    <Setter Property="MinHeight" Value="150" />
  </Style>
  <Style Selector=".compact Border.hero TextBlock.hero-value">
    <Setter Property="FontSize" Value="44" />
  </Style>
  <Style Selector=".compact Border.hero TextBlock.hero-unit">
    <Setter Property="FontSize" Value="22" />
  </Style>
  <Style Selector=".compact views|SlimeMascot.hero-slime">
    <Setter Property="Width" Value="110" />
    <Setter Property="Height" Value="110" />
  </Style>
  <Style Selector=".compact UniformGrid.tiles Border.stat">
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector=".compact UniformGrid.tiles TextBlock.stat-label">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector=".compact UniformGrid.tiles TextBlock.stat-value">
    <Setter Property="FontSize" Value="24" />
  </Style>
  <!-- Metas: ações do cartão na linha de baixo, sob o texto -->
  <Style Selector=".compact StackPanel.card-actions">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <!-- Formulário de meta: largura fluida, campos lado a lado empilhados, ações no fim da rolagem -->
  <Style Selector=".compact StackPanel.goal-form">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="MaxWidth" Value="Infinity" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <!-- folga à direita para a barra de rolagem sobreposta não cobrir campos e o Salvar -->
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector=".compact StackPanel.field-row">
    <Setter Property="Orientation" Value="Vertical" />
  </Style>
  <Style Selector=".compact TextBlock.row-label">
    <Setter Property="MinWidth" Value="40" />
  </Style>
  <Style Selector=".compact StackPanel.delete-actions">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>
  <Style Selector=".compact TextBlock.delete-warning">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector=".compact ContentControl.goal-actions.docked">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".compact ContentControl.goal-actions.inline">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <!-- Relatórios: tiles em coluna única, segmento abaixo do título, barras mais finas -->
  <Style Selector=".compact UniformGrid.report-tiles">
    <Setter Property="Columns" Value="1" />
  </Style>
  <Style Selector=".compact Border.report-mode">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <!-- "N disparados · N respondidos" cabe numa linha em 22px; quebra só se os números crescerem -->
  <Style Selector=".compact UniformGrid.report-tiles TextBlock.stat-value">
    <Setter Property="FontSize" Value="22" />
  </Style>
  <Style Selector=".compact Border.bar">
    <Setter Property="Width" Value="22" />
  </Style>
  <!-- Configurações: cartões na largura toda -->
  <Style Selector=".compact StackPanel.settings-list">
    <Setter Property="MaxWidth" Value="Infinity" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
</Styles>
