<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SlimeGoals.App.Views"
        xmlns:vm="using:SlimeGoals.App.ViewModels"
        x:Class="SlimeGoals.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="SlimeGoals" Width="1100" Height="720" MinWidth="900" MinHeight="600">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Q" Command="{Binding QuitCommand}" />
  </Window.KeyBindings>
  <views:ShellView />
</Window>
