<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SlimeGoals.App.Views"
        xmlns:vm="using:SlimeGoals.App.ViewModels"
        x:Class="SlimeGoals.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="SlimeGoals" Icon="avares://SlimeGoals.App/Assets/icon-256.png" Width="1100" Height="720" MinWidth="900" MinHeight="600">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Q" Command="{Binding QuitCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <!-- Menus, listas e dicas abrem em janelas próprias: herdam o zoom de quem os abriu (UiScale) -->
    <Style Selector="Popup">
      <Setter Property="InheritsTransform" Value="True" />
    </Style>
  </Window.Styles>
  <!-- Zoom do app numa janela grande (UiScale, posto pelo code-behind); o shell faz o layout no tamanho desenhado -->
  <LayoutTransformControl x:Name="Zoom">
    <views:ShellView />
  </LayoutTransformControl>
</Window>
