<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:SlimeGoals.App.Views"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             x:Class="SlimeGoals.App.Views.TodayView"
             x:DataType="vm:TodayPageViewModel">
  <DockPanel Classes="page">
    <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="{Binding Title}" Margin="0,0,0,16" />

    <!-- Cartão de destaque: progresso da semana e mascote -->
    <Border DockPanel.Dock="Top" Classes="hero" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Classes="hero-label" Text="Progresso da semana" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock Classes="hero-value" Text="{Binding WeekPercent}" />
            <TextBlock Classes="hero-unit" Text="%" />
          </StackPanel>
          <ProgressBar Classes="hero" Minimum="0" Maximum="100" Value="{Binding WeekPercent}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding HasMascot}">
          <Border Classes="hero-bubble">
            <TextBlock Text="{Binding Mascot.Message}" Foreground="{DynamicResource HeroBubbleText}"
                       FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
          </Border>
          <views:SlimeMascot Classes="hero-slime" Pose="{Binding Mascot.Pose}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- A linha do rótulo tem a mesma altura nos três blocos (SharedSizeGroup): os valores ficam alinhados mesmo
         quando um rótulo quebra em duas linhas na tela estreita -->
    <UniformGrid DockPanel.Dock="Top" Classes="tiles" Grid.IsSharedSizeScope="True" Margin="0,0,0,16">
      <Border Classes="stat">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" SharedSizeGroup="StatLabel" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Classes="stat-label" Text="Em andamento" />
          <TextBlock Grid.Row="1" Classes="stat-value" Text="{Binding InProgress}" />
        </Grid>
      </Border>
      <Border Classes="stat">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" SharedSizeGroup="StatLabel" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Classes="stat-label" Text="Concluídas hoje" />
          <TextBlock Grid.Row="1" Classes="stat-value" Text="{Binding Completed}" />
        </Grid>
      </Border>
      <Border Classes="stat">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" SharedSizeGroup="StatLabel" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Classes="stat-label" Text="Sequência" />
          <!-- A meta da sequência fica ao lado do valor na tela larga e embaixo na estreita (estilo stat-caption) -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Classes="stat-value" Text="{Binding StreakValue}" />
            <TextBlock Grid.Column="1" Classes="stat-unit" Text="{Binding StreakUnit}" />
            <TextBlock Classes="stat-caption" Text="{Binding StreakGoal}"
                       IsVisible="{Binding StreakGoal, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </Grid>
      </Border>
    </UniformGrid>

    <Border DockPanel.Dock="Top" Classes="warning-band" Margin="0,0,0,12"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </Border>

    <!-- Cronômetro de meta fora da lista de hoje (ex.: dia inativo): ainda dá para parar ou descartar -->
    <Border DockPanel.Dock="Top" Classes="inline-panel" Margin="0,0,0,12" IsVisible="{Binding HasOffscreenTimer}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding OffscreenTimerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="Parar" IsVisible="{Binding IsOffscreenTimerRunning}"
                  Command="{Binding StopOffscreenTimerCommand}" />
          <Button Classes="ghost" Content="Descartar" Command="{Binding DiscardOffscreenTimerCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Permissões dos lembretes em falta (Android) -->
    <Border DockPanel.Dock="Top" Classes="inline-panel" Margin="0,0,0,12" IsVisible="{Binding HasPermissionWarning}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding PermissionWarning}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="ghost" MinHeight="44" Content="Permitir" Command="{Binding RequestPermissionCommand}" />
      </Grid>
    </Border>

    <!-- Lembretes pausados (mesmo estilo da faixa do cronômetro) -->
    <Border DockPanel.Dock="Top" Classes="inline-panel" Margin="0,0,0,12" IsVisible="{Binding IsPaused}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="Lembretes pausados" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="ghost" Content="Retomar" Command="{Binding TogglePauseCommand}" />
      </Grid>
    </Border>

    <!-- Cabeçalho da lista; "Pausar lembretes" fica aqui para valer mesmo sem próximos lembretes -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBlock Classes="section-title" Text="Metas de hoje" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="ghost" Content="Pausar lembretes"
              IsVisible="{Binding CanPause}" Command="{Binding TogglePauseCommand}" />
    </Grid>

    <Panel>
      <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" Foreground="{DynamicResource Muted}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
      <ScrollViewer Classes="page" IsVisible="{Binding !IsEmpty}">
        <StackPanel>
        <ItemsControl ItemsSource="{Binding Goals}" Margin="0,0,0,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodayGoalViewModel">
              <Border Classes="card today" Classes.met="{Binding IsMet}" Margin="0,0,0,10">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="icon-tile"
                            Background="{Binding Color, Converter={StaticResource GoalColorBrush}, ConverterParameter=Bg}">
                      <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                          <Path Classes="goal-icon" Data="{Binding IconKey, Converter={StaticResource IconGeometry}}"
                                Stroke="{Binding Color, Converter={StaticResource GoalColorBrush}, ConverterParameter=Fg}" />
                        </Canvas>
                      </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                      <DockPanel LastChildFill="True">
                        <!-- Meta cumprida: a palavra na tela larga; na estreita, o ✓ dos Relatórios, que não espreme o título -->
                        <TextBlock DockPanel.Dock="Right" Classes="met-tag" Classes.met="{Binding IsMet}" Text="concluída" />
                        <Path DockPanel.Dock="Right" Classes="met-icon in-title" Classes.met="{Binding IsMet}"
                              Data="{StaticResource IconCheck}" AutomationProperties.Name="concluída" ToolTip.Tip="Concluída" />
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <!-- Na tela estreita o tempo corrido vem para cá: ao lado dos botões ele espremia o título -->
                      <TextBlock Classes="elapsed narrow" Classes.running="{Binding IsTimerRunning}" Text="{Binding Elapsed}" />
                      <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource Muted}" FontSize="13"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Controles por medida -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <!-- Conclusão -->
                      <Button Classes="ghost icon" AutomationProperties.Name="Desmarcar" ToolTip.Tip="Desmarcar"
                              IsVisible="{Binding IsCompletion}" IsEnabled="{Binding IsMet}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).UncompleteCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconX}" />
                      </Button>
                      <Button Classes="primary icon" AutomationProperties.Name="Feito" ToolTip.Tip="Marcar como feito"
                              IsVisible="{Binding IsCompletion}" IsEnabled="{Binding !IsMet}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).CompleteCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconCheck}" />
                      </Button>
                      <!-- Quantidade -->
                      <Button Classes="ghost icon" IsVisible="{Binding IsQuantity}"
                              AutomationProperties.Name="Remover 1" ToolTip.Tip="Remover 1"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).DecrementCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconMinus}" />
                      </Button>
                      <Button Classes="primary icon" IsVisible="{Binding IsQuantity}"
                              AutomationProperties.Name="Adicionar 1" ToolTip.Tip="Adicionar 1"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).IncrementCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconPlus}" />
                      </Button>
                      <!-- Tempo -->
                      <TextBlock Classes="elapsed wide" Classes.running="{Binding IsTimerRunning}" Text="{Binding Elapsed}" />
                      <Button Classes="primary icon" AutomationProperties.Name="Iniciar cronômetro" ToolTip.Tip="Iniciar cronômetro"
                              IsEnabled="{Binding CanStartTimer}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).StartTimerCommand}"
                              CommandParameter="{Binding}">
                        <Button.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsDuration" />
                            <Binding Path="HasNoTimer" />
                          </MultiBinding>
                        </Button.IsVisible>
                        <Path Classes="btn-icon" Data="{StaticResource IconPlay}" />
                      </Button>
                      <Button Classes="danger-solid icon" AutomationProperties.Name="Parar cronômetro" ToolTip.Tip="Parar cronômetro"
                              IsVisible="{Binding IsTimerRunning}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).StopTimerCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconStop}" />
                      </Button>
                      <!-- Mais opções (só tempo) -->
                      <Button Classes="ghost icon" AutomationProperties.Name="Lançar tempo" ToolTip.Tip="Lançar ou remover tempo"
                              IsVisible="{Binding IsDuration}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).OpenPanelCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconEllipsis}" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <!-- Barra na largura do cartão: igual em todos, sem depender dos botões ao lado do texto -->
                  <ProgressBar Classes="goal" Minimum="0" Maximum="1" Value="{Binding Fraction}" />

                  <!-- Painel de valor -->
                  <Border Classes="inline-panel" IsVisible="{Binding IsPanelOpen}">
                    <StackPanel Spacing="10">
                      <Border Classes="segment" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton Classes="segment" Content="Adicionar" IsChecked="{Binding PanelAdds}" />
                          <RadioButton Classes="segment" Content="Remover" IsChecked="{Binding PanelRemoves}" />
                        </StackPanel>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <NumericUpDown Value="{Binding PanelHoursInput}" Minimum="0" Maximum="24" Increment="1"
                                       FormatString="0" Width="110" AutomationProperties.Name="Horas" />
                        <TextBlock Text="h" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding PanelMinutesInput}" Minimum="0" Maximum="59" Increment="1"
                                       FormatString="0" Width="110" AutomationProperties.Name="Minutos" />
                        <TextBlock Text="min" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBox Text="{Binding PanelNote}" MaxLength="200" PlaceholderText="Nota (opcional)"
                               AutomationProperties.Name="Nota" />
                      <TextBlock Classes="field-error" Text="{Binding PanelError}"
                                 IsVisible="{Binding PanelError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Cancelar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).CancelPanelCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="primary" Content="Registrar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).ConfirmPanelCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- Cronômetro parado: conferir e registrar -->
                  <Border Classes="inline-panel" IsVisible="{Binding IsTimerStopped}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="{Binding StoppedText}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <NumericUpDown Value="{Binding StoppedMinutesInput}" Minimum="0" Maximum="1440" Increment="1"
                                       FormatString="0" Width="130" AutomationProperties.Name="Minutos cronometrados" />
                        <TextBlock Text="min" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBox Text="{Binding PanelNote}" MaxLength="200" PlaceholderText="Nota (opcional)"
                               AutomationProperties.Name="Nota" />
                      <TextBlock Classes="field-error" Text="{Binding PanelError}"
                                 IsVisible="{Binding PanelError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Descartar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).DiscardTimerCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="primary" Content="Registrar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).RegisterTimerCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
    <!-- Próximos lembretes do dia, depois das metas e dentro da rolagem (só com itens):
         fora dela, cada meta com lembrete tirava uma linha da lista no celular -->
    <StackPanel Margin="0,4,0,14" IsVisible="{Binding HasUpcoming}">
      <TextBlock Classes="section-title" Text="Próximos lembretes" Margin="0,0,0,10" />
      <ItemsControl ItemsSource="{Binding Upcoming}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:UpcomingReminderViewModel">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,6">
              <TextBlock Text="{Binding Time}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource Muted}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
