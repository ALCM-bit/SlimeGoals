<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:SlimeGoals.App.Views"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             xmlns:services="using:SlimeGoals.Core.Services"
             x:Class="SlimeGoals.App.Views.TodayView"
             x:DataType="vm:TodayPageViewModel">
  <UserControl.Styles>
    <!-- Teclado aberto (celular): some o destaque e os blocos, senão a lista fica sem altura e o campo em edição some -->
    <Style Selector="DockPanel.keyboard > Border.hero, DockPanel.keyboard > UniformGrid.tiles">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Trechos de hoje: o chevron aponta para cima com a lista aberta -->
    <Style Selector="Path.chunks-chevron.open">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="Button.chunks-toggle">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <DockPanel x:Name="PageRoot" Classes="page">
    <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="{Binding Title}" Margin="0,0,0,16" />

    <!-- Cartão de destaque: progresso da semana e mascote -->
    <Border DockPanel.Dock="Top" Classes="hero" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Classes="hero-label" Text="Progresso da semana" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock Classes="hero-value" Text="{Binding WeekPercent}" />
            <TextBlock Classes="hero-unit" Text="%" />
          </StackPanel>
          <ProgressBar Classes="hero" Minimum="0" Maximum="100" Value="{Binding WeekPercent}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding HasMascot}">
          <Border Classes="hero-bubble">
            <TextBlock Text="{Binding Mascot.Message}" Foreground="{DynamicResource HeroBubbleText}"
                       FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
          </Border>
          <views:SlimeMascot Classes="hero-slime" Pose="{Binding Mascot.Pose}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- A linha do rótulo tem a mesma altura nos três blocos (SharedSizeGroup): os valores ficam alinhados mesmo
         quando um rótulo quebra em duas linhas na tela estreita -->
    <UniformGrid DockPanel.Dock="Top" Classes="tiles" Grid.IsSharedSizeScope="True" Margin="0,0,0,16">
      <Border Classes="stat">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" SharedSizeGroup="StatLabel" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Classes="stat-label" Text="Em andamento" />
          <TextBlock Grid.Row="1" Classes="stat-value" Text="{Binding InProgress}" />
        </Grid>
      </Border>
      <Border Classes="stat">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" SharedSizeGroup="StatLabel" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Classes="stat-label" Text="Concluídas hoje" />
          <TextBlock Grid.Row="1" Classes="stat-value" Text="{Binding Completed}" />
        </Grid>
      </Border>
      <Border Classes="stat">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" SharedSizeGroup="StatLabel" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Classes="stat-label" Text="Sequência" />
          <!-- A meta da sequência fica ao lado do valor na tela larga e embaixo na estreita (estilo stat-caption) -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Classes="stat-value" Text="{Binding StreakValue}" />
            <TextBlock Grid.Column="1" Classes="stat-unit" Text="{Binding StreakUnit}" />
            <TextBlock Classes="stat-caption" Text="{Binding StreakGoal}"
                       IsVisible="{Binding StreakGoal, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </Grid>
      </Border>
    </UniformGrid>

    <Border DockPanel.Dock="Top" Classes="warning-band" Margin="0,0,0,12"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </Border>

    <!-- Sessão de Pomodoro aberta: o ▶ dos cartões fica desligado, e a faixa leva à aba Tempo (spec Pomodoro §4.1) -->
    <Border DockPanel.Dock="Top" Classes="inline-panel" Margin="0,0,0,12" IsVisible="{Binding HasFocusBand}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding FocusBandText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="ghost" Content="Abrir Tempo" Command="{Binding OpenTimePageCommand}" />
      </Grid>
    </Border>

    <!-- Cronômetro de meta fora da lista de hoje (ex.: dia inativo): ainda dá para parar ou descartar -->
    <Border DockPanel.Dock="Top" Classes="inline-panel" Margin="0,0,0,12" IsVisible="{Binding HasOffscreenTimer}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding OffscreenTimerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="Parar" IsVisible="{Binding IsOffscreenTimerRunning}"
                  Command="{Binding StopOffscreenTimerCommand}" />
          <Button Classes="ghost" Content="Descartar" Command="{Binding DiscardOffscreenTimerCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Permissões dos lembretes em falta (Android) -->
    <Border DockPanel.Dock="Top" Classes="inline-panel" Margin="0,0,0,12" IsVisible="{Binding HasPermissionWarning}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding PermissionWarning}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="ghost" MinHeight="44" Content="Permitir" Command="{Binding RequestPermissionCommand}" />
      </Grid>
    </Border>

    <!-- Sincronização parada há dias (conta ligada) -->
    <Border DockPanel.Dock="Top" Classes="inline-panel" Margin="0,0,0,12" IsVisible="{Binding HasSyncWarning}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding SyncWarning}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="ghost" MinHeight="44" Content="Abrir" Command="{Binding OpenSyncCommand}" />
      </Grid>
    </Border>

    <!-- Lembretes pausados (mesmo estilo da faixa do cronômetro) -->
    <Border DockPanel.Dock="Top" Classes="inline-panel" Margin="0,0,0,12" IsVisible="{Binding IsPaused}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="Lembretes pausados" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="ghost" Content="Retomar" Command="{Binding TogglePauseCommand}" />
      </Grid>
    </Border>

    <!-- Cabeçalho da lista; "Pausar lembretes" fica aqui para valer mesmo sem próximos lembretes -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBlock Classes="section-title" Text="Metas de hoje" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="ghost" Content="Pausar lembretes"
              IsVisible="{Binding CanPause}" Command="{Binding TogglePauseCommand}" />
    </Grid>

    <!-- Filtro por tags: "Limpar" fixo à esquerda, só com seleção; os chips rolam de lado (nunca quebram) -->
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12" DataContext="{Binding Filter}"
                x:DataType="vm:TodayTagFilterViewModel" IsVisible="{Binding IsVisible}">
      <Grid ColumnDefinitions="Auto,*">
        <Button Classes="ghost" Content="✕ Limpar" MinHeight="36" Padding="12,0" Margin="0,0,8,0" VerticalAlignment="Center"
                IsVisible="{Binding HasSelection}" Command="{Binding ClearCommand}" />
        <Panel Grid.Column="1">
          <ScrollViewer x:Name="TagStrip" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Chips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TagChipViewModel">
                  <views:TagChip Command="{Binding $parent[ItemsControl].((vm:TodayTagFilterViewModel)DataContext).ToggleCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <!-- Há mais chips à direita: esmaecido até o fundo da página e a seta "›" que rola um passo (spec §4.8) -->
          <Border x:Name="TagStripFade" Width="60" HorizontalAlignment="Right" IsHitTestVisible="False" IsVisible="False"
                  Background="{DynamicResource Bg}">
            <Border.OpacityMask>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="1" Color="#FF000000" />
              </LinearGradientBrush>
            </Border.OpacityMask>
          </Border>
          <Button x:Name="TagStripMore" Width="28" Height="28" MinHeight="28" Padding="0" CornerRadius="14"
                  HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="False"
                  Background="{DynamicResource Surface2}" AutomationProperties.Name="Mais tags" ToolTip.Tip="Mais tags"
                  Click="OnTagStripMore">
            <TextBlock Text="›" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Panel>
      </Grid>
      <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Muted}" FontSize="13"
                 IsVisible="{Binding HasSelection}" />
    </StackPanel>

    <Panel>
      <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" Foreground="{DynamicResource Muted}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
      <ScrollViewer Classes="page" IsVisible="{Binding !IsEmpty}">
        <StackPanel>
        <ItemsControl ItemsSource="{Binding Goals}" Margin="0,0,0,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodayGoalViewModel">
              <Border Classes="card today" Classes.met="{Binding IsMet}" Margin="0,0,0,10" IsVisible="{Binding IsShown}">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="icon-tile"
                            Background="{Binding Color, Converter={StaticResource GoalColorBrush}, ConverterParameter=Bg}">
                      <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                          <Path Classes="goal-icon" Data="{Binding IconKey, Converter={StaticResource IconGeometry}}"
                                Stroke="{Binding Color, Converter={StaticResource GoalColorBrush}, ConverterParameter=Fg}" />
                        </Canvas>
                      </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                      <DockPanel LastChildFill="True">
                        <!-- Meta cumprida: a palavra na tela larga; na estreita, o ✓ dos Relatórios, que não espreme o título -->
                        <TextBlock DockPanel.Dock="Right" Classes="met-tag" Classes.met="{Binding IsMet}" Text="concluída" />
                        <Path DockPanel.Dock="Right" Classes="met-icon in-title" Classes.met="{Binding IsMet}"
                              Data="{StaticResource IconCheck}" AutomationProperties.Name="concluída" ToolTip.Tip="Concluída" />
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <!-- Na tela estreita o tempo corrido vem para cá: ao lado dos botões ele espremia o título -->
                      <TextBlock Classes="elapsed narrow" Classes.running="{Binding IsTimerRunning}" Text="{Binding Elapsed}" />
                      <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource Muted}" FontSize="13"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Controles por medida -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <!-- Conclusão -->
                      <Button Classes="ghost icon" AutomationProperties.Name="Desmarcar" ToolTip.Tip="Desmarcar"
                              IsVisible="{Binding IsCompletion}" IsEnabled="{Binding IsMet}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).UncompleteCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconX}" />
                      </Button>
                      <Button Classes="primary icon" AutomationProperties.Name="Feito" ToolTip.Tip="Marcar como feito"
                              IsVisible="{Binding IsCompletion}" IsEnabled="{Binding !IsMet}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).CompleteCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconCheck}" />
                      </Button>
                      <!-- Quantidade -->
                      <Button Classes="ghost icon" IsVisible="{Binding IsQuantity}"
                              AutomationProperties.Name="Remover 1" ToolTip.Tip="Remover 1"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).DecrementCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconMinus}" />
                      </Button>
                      <Button Classes="primary icon" IsVisible="{Binding IsQuantity}"
                              AutomationProperties.Name="Adicionar 1" ToolTip.Tip="Adicionar 1"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).IncrementCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconPlus}" />
                      </Button>
                      <!-- Tempo -->
                      <TextBlock Classes="elapsed wide" Classes.running="{Binding IsTimerRunning}" Text="{Binding Elapsed}" />
                      <Button Classes="primary icon" AutomationProperties.Name="Iniciar cronômetro" ToolTip.Tip="Iniciar cronômetro"
                              IsEnabled="{Binding CanStartTimer}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).StartTimerCommand}"
                              CommandParameter="{Binding}">
                        <Button.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsDuration" />
                            <Binding Path="HasNoTimer" />
                          </MultiBinding>
                        </Button.IsVisible>
                        <Path Classes="btn-icon" Data="{StaticResource IconPlay}" />
                      </Button>
                      <!-- No modo de troca, Trocar e Cancelar ocupam o lugar de ⇄ e ■ (abaixo do campo) -->
                      <Button Classes="danger-solid icon" AutomationProperties.Name="Parar cronômetro" ToolTip.Tip="Parar cronômetro"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).StopTimerCommand}"
                              CommandParameter="{Binding}">
                        <Button.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsTimerRunning" />
                            <Binding Path="!IsSwitchingTask" />
                          </MultiBinding>
                        </Button.IsVisible>
                        <Path Classes="btn-icon" Data="{StaticResource IconStop}" />
                      </Button>
                      <!-- Mais opções (só tempo) -->
                      <Button Classes="ghost icon" AutomationProperties.Name="Lançar tempo" ToolTip.Tip="Lançar ou remover tempo"
                              IsVisible="{Binding IsDuration}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).OpenPanelCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconEllipsis}" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <!-- Tarefa do cronômetro rodando: na largura do cartão, para não espremer o título na tela estreita -->
                  <StackPanel Spacing="8" IsVisible="{Binding IsTimerRunning}">
                    <!-- Nome gravado: texto, e não campo, é a confirmação de que ele está valendo (spec §7.1).
                         ✎ e ⇄ aqui, e não junto do ■: a 320 px, três botões no cabeçalho cortavam o título e o tempo -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ShowsTaskLabel}">
                      <TextBlock Text="{Binding TaskLabel}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TimerTask}" />
                      <Button Grid.Column="1" Classes="ghost icon" AutomationProperties.Name="Editar tarefa" ToolTip.Tip="Editar tarefa"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).BeginEditTaskCommand}"
                              CommandParameter="{Binding}" Click="OnEditTaskClick">
                        <Path Classes="btn-icon" Data="{StaticResource IconPencil}" />
                      </Button>
                      <Button Grid.Column="2" Classes="ghost icon" AutomationProperties.Name="Trocar de tarefa" ToolTip.Tip="Trocar de tarefa"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).BeginSwitchTaskCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="btn-icon" Data="{StaticResource IconSwap}" />
                      </Button>
                    </Grid>
                    <!-- Sem nome, editando ou trocando: o campo, com ✓ (e ✕ ao editar um nome que já existe) -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ShowsTaskField}">
                      <AutoCompleteBox Classes="timer-task" Text="{Binding TaskInput, Mode=TwoWay}" ItemsSource="{Binding TaskSuggestions}"
                                       PlaceholderText="No que está trabalhando?" FilterMode="Contains" MinimumPrefixLength="0"
                                       MaxLength="{x:Static services:CheckinService.MaxNoteLength}"
                                       AutomationProperties.Name="Tarefa" SelectionChanged="OnTaskSelectionChanged" />
                      <Button Grid.Column="1" Classes="primary icon" AutomationProperties.Name="Confirmar tarefa" ToolTip.Tip="Confirmar tarefa"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).SaveTaskCommand}"
                              CommandParameter="{Binding}" IsVisible="{Binding ShowsConfirmTask}">
                        <Path Classes="btn-icon" Data="{StaticResource IconCheck}" />
                      </Button>
                      <Button Grid.Column="2" Classes="ghost icon" AutomationProperties.Name="Cancelar edição" ToolTip.Tip="Cancelar edição"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).CancelEditTaskCommand}"
                              CommandParameter="{Binding}" IsVisible="{Binding IsEditingTask}">
                        <Path Classes="btn-icon" Data="{StaticResource IconX}" />
                      </Button>
                    </Grid>
                    <!-- Trocar de tarefa: os botões abaixo do campo, como no painel de registro, para não espremê-lo no celular -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding IsSwitchingTask}">
                      <Button Classes="ghost" Content="Cancelar"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).CancelSwitchTaskCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="primary" Content="Trocar"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).ConfirmSwitchTaskCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- Barra na largura do cartão: igual em todos, sem depender dos botões ao lado do texto -->
                  <ProgressBar Classes="goal" Minimum="0" Maximum="1" Value="{Binding Fraction}" />

                  <!-- Tags da meta: chips pequenos, só se ela tem tags -->
                  <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TagChipViewModel">
                        <views:TagChip Classes="small" IsHitTestVisible="False" Focusable="False" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Trechos de hoje (spec §7.2): recolhível, fechado por padrão; o editor abre no lugar da linha -->
                  <StackPanel Spacing="6" IsVisible="{Binding HasChunks}">
                    <Button Classes="ghost chunks-toggle" AutomationProperties.Name="Trechos de hoje"
                            Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).ToggleChunksCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding ChunksHeader}" VerticalAlignment="Center" />
                        <Path Grid.Column="1" Classes="btn-icon chunks-chevron" Classes.open="{Binding IsChunksOpen}"
                              Data="{StaticResource IconChevronDown}" />
                      </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Chunks}" IsVisible="{Binding IsChunksOpen}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TodayChunkViewModel">
                          <StackPanel>
                            <!-- Linha: nome, tempo e ✎; a coluna do ✎ fica reservada (44, a largura do Button.icon) para o
                                 tempo do trecho em andamento e o da compensação ficarem alinhados com os outros -->
                            <Grid ColumnDefinitions="*,Auto,44" ColumnSpacing="8" MinHeight="44" IsVisible="{Binding !IsEditing}">
                              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding Name}" />
                              <TextBlock Grid.Column="1" Classes.running="{Binding IsRunning}" Text="{Binding Text}"
                                         VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                              <Button Grid.Column="2" Classes="ghost icon" AutomationProperties.Name="Ajustar trecho" ToolTip.Tip="Ajustar trecho"
                                      Command="{Binding $parent[UserControl].((vm:TodayPageViewModel)DataContext).EditChunkCommand}" CommandParameter="{Binding}"
                                      IsVisible="{Binding ShowsEditButton}">
                                <Path Classes="btn-icon" Data="{StaticResource IconPencil}" />
                              </Button>
                            </Grid>
                            <!-- Editor no lugar da linha -->
                            <Border Classes="inline-panel" IsVisible="{Binding IsEditing}">
                              <StackPanel Spacing="10">
                                <!-- Título com Apagar à direita: na linha de Cancelar e Salvar ele não cabia a 320 px -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                  <TextBlock Text="Ajustar trecho" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                  <Button Grid.Column="1" Classes="danger" Content="Apagar"
                                          Command="{Binding $parent[UserControl].((vm:TodayPageViewModel)DataContext).DeleteChunkCommand}"
                                          CommandParameter="{Binding}" />
                                </Grid>
                                <!-- Horas, minutos e segundos, quebrando linha quando não cabem -->
                                <WrapPanel ItemSpacing="16" LineSpacing="10">
                                  <StackPanel Orientation="Horizontal" Spacing="10">
                                    <NumericUpDown Value="{Binding HoursInput}" Minimum="0" Maximum="24" Increment="1"
                                                   FormatString="0" Width="110" AutomationProperties.Name="Horas" />
                                    <TextBlock Text="h" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Spacing="10">
                                    <NumericUpDown Value="{Binding MinutesInput}" Minimum="0" Maximum="59" Increment="1"
                                                   FormatString="0" Width="110" AutomationProperties.Name="Minutos" />
                                    <TextBlock Text="min" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Spacing="10">
                                    <NumericUpDown Value="{Binding SecondsInput}" Minimum="0" Maximum="59" Increment="1"
                                                   FormatString="0" Width="110" AutomationProperties.Name="Segundos" />
                                    <TextBlock Text="s" VerticalAlignment="Center" />
                                  </StackPanel>
                                </WrapPanel>
                                <TextBox Text="{Binding NoteInput}" MaxLength="{x:Static services:CheckinService.MaxNoteLength}"
                                         PlaceholderText="Nome (opcional)" AutomationProperties.Name="Nome do trecho" />
                                <TextBlock Classes="field-error" Text="{Binding Error}" TextWrapping="Wrap"
                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                  <Button Classes="ghost" Content="Cancelar"
                                          Command="{Binding $parent[UserControl].((vm:TodayPageViewModel)DataContext).CancelChunkEditCommand}"
                                          CommandParameter="{Binding}" />
                                  <Button Classes="primary" Content="Salvar"
                                          Command="{Binding $parent[UserControl].((vm:TodayPageViewModel)DataContext).SaveChunkCommand}"
                                          CommandParameter="{Binding}" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Painel de valor -->
                  <Border Classes="inline-panel" IsVisible="{Binding IsPanelOpen}">
                    <StackPanel Spacing="10">
                      <Border Classes="segment" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton Classes="segment" Content="Adicionar" IsChecked="{Binding PanelAdds}" />
                          <RadioButton Classes="segment" Content="Remover" IsChecked="{Binding PanelRemoves}" />
                        </StackPanel>
                      </Border>
                      <!-- Horas e minutos quebram linha quando não cabem lado a lado (320 e 360 px) -->
                      <WrapPanel ItemSpacing="16" LineSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <NumericUpDown Value="{Binding PanelHoursInput}" Minimum="0" Maximum="24" Increment="1"
                                         FormatString="0" Width="110" AutomationProperties.Name="Horas" />
                          <TextBlock Text="h" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <NumericUpDown Value="{Binding PanelMinutesInput}" Minimum="0" Maximum="59" Increment="1"
                                         FormatString="0" Width="110" AutomationProperties.Name="Minutos" />
                          <TextBlock Text="min" VerticalAlignment="Center" />
                        </StackPanel>
                      </WrapPanel>
                      <TextBox Text="{Binding PanelNote}" MaxLength="{x:Static services:CheckinService.MaxNoteLength}" PlaceholderText="Nota (opcional)"
                               AutomationProperties.Name="Nota" />
                      <TextBlock Classes="field-error" Text="{Binding PanelError}"
                                 IsVisible="{Binding PanelError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Cancelar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).CancelPanelCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="primary" Content="Registrar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).ConfirmPanelCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- Cronômetro parado: conferir e registrar -->
                  <Border Classes="inline-panel" IsVisible="{Binding IsTimerStopped}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="{Binding StoppedText}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                      <!-- Horas, minutos e segundos, quebrando linha quando não cabem -->
                      <WrapPanel ItemSpacing="16" LineSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <NumericUpDown Value="{Binding StoppedHoursInput}" Minimum="0" Maximum="24" Increment="1"
                                         FormatString="0" Width="110" AutomationProperties.Name="Horas cronometradas" />
                          <TextBlock Text="h" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <NumericUpDown Value="{Binding StoppedMinutesInput}" Minimum="0" Maximum="59" Increment="1"
                                         FormatString="0" Width="110" AutomationProperties.Name="Minutos cronometrados" />
                          <TextBlock Text="min" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <NumericUpDown Value="{Binding StoppedSecondsInput}" Minimum="0" Maximum="59" Increment="1"
                                         FormatString="0" Width="110" AutomationProperties.Name="Segundos cronometrados" />
                          <TextBlock Text="s" VerticalAlignment="Center" />
                        </StackPanel>
                      </WrapPanel>
                      <TextBox Text="{Binding PanelNote}" MaxLength="{x:Static services:CheckinService.MaxNoteLength}" PlaceholderText="Nota (opcional)"
                               AutomationProperties.Name="Nota" />
                      <TextBlock Classes="field-error" Text="{Binding PanelError}"
                                 IsVisible="{Binding PanelError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Descartar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).DiscardTimerCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="primary" Content="Registrar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).RegisterTimerCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Nenhuma meta de hoje com essas tags." IsVisible="{Binding Filter.IsFilteredEmpty}"
                   Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" FontSize="15" Margin="0,24,0,24" />
    <!-- Próximos lembretes do dia, depois das metas e dentro da rolagem (só com itens):
         fora dela, cada meta com lembrete tirava uma linha da lista no celular -->
    <StackPanel Margin="0,4,0,14" IsVisible="{Binding HasUpcoming}">
      <TextBlock Classes="section-title" Text="Próximos lembretes" Margin="0,0,0,10" />
      <ItemsControl ItemsSource="{Binding Upcoming}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:UpcomingReminderViewModel">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,6">
              <TextBlock Text="{Binding Time}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource Muted}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
