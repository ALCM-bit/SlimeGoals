<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             x:Class="SlimeGoals.App.Views.TodayView"
             x:DataType="vm:TodayPageViewModel">
  <DockPanel Margin="8,4,8,0">
    <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="{Binding Title}" Margin="0,0,0,16" />

    <!-- Resumo da semana (spec §7; sequência chega na Fase 5) -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,0,0,16">
      <Border Classes="stat">
        <StackPanel>
          <TextBlock Classes="stat-label" Text="Progresso da semana" />
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock Classes="stat-value" Text="{Binding WeekPercent}" />
            <TextBlock Classes="stat-unit" Text="%" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="stat">
        <StackPanel>
          <TextBlock Classes="stat-label" Text="Em andamento" />
          <TextBlock Classes="stat-value" Text="{Binding InProgress}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="stat">
        <StackPanel>
          <TextBlock Classes="stat-label" Text="Concluídas hoje" />
          <TextBlock Classes="stat-value" Text="{Binding Completed}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border DockPanel.Dock="Top" Classes="warning-band" Margin="0,0,0,12"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </Border>

    <TextBlock DockPanel.Dock="Top" Classes="section-title" Text="Metas de hoje" Margin="0,0,0,10" />

    <Panel>
      <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" Foreground="{DynamicResource Muted}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
      <ScrollViewer IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Goals}" Margin="0,0,0,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodayGoalViewModel">
              <Border Classes="card today" Classes.met="{Binding IsMet}" Margin="0,0,0,10">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="icon-tile"
                            Background="{Binding Color, Converter={StaticResource GoalColorBrush}, ConverterParameter=Bg}">
                      <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                          <Path Classes="goal-icon" Data="{Binding IconKey, Converter={StaticResource IconGeometry}}"
                                Stroke="{Binding Color, Converter={StaticResource GoalColorBrush}, ConverterParameter=Fg}" />
                        </Canvas>
                      </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="concluída" Foreground="{DynamicResource Success}" FontSize="12"
                                   VerticalAlignment="Center" IsVisible="{Binding IsMet}" />
                      </StackPanel>
                      <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource Muted}" FontSize="13" />
                      <ProgressBar Classes="goal" Minimum="0" Maximum="1" Value="{Binding Fraction}" />
                    </StackPanel>

                    <!-- Controles por medida -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <!-- Conclusão -->
                      <Button Classes="primary" Content="Feito"
                              IsVisible="{Binding IsCompletion}" IsEnabled="{Binding !IsMet}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).CompleteCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="ghost" Content="Desmarcar"
                              IsVisible="{Binding IsCompletion}" IsEnabled="{Binding IsMet}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).UncompleteCommand}"
                              CommandParameter="{Binding}" />
                      <!-- Quantidade -->
                      <Button Classes="ghost icon" Content="−" IsVisible="{Binding IsQuantity}"
                              AutomationProperties.Name="Remover 1"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).DecrementCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="primary icon" Content="+" IsVisible="{Binding IsQuantity}"
                              AutomationProperties.Name="Adicionar 1"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).IncrementCommand}"
                              CommandParameter="{Binding}" />
                      <!-- Tempo -->
                      <TextBlock Text="{Binding Elapsed}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                 IsVisible="{Binding IsTimerRunning}" />
                      <Button Classes="primary icon" Content="▶" AutomationProperties.Name="Iniciar cronômetro"
                              IsEnabled="{Binding CanStartTimer}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).StartTimerCommand}"
                              CommandParameter="{Binding}">
                        <Button.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsDuration" />
                            <Binding Path="HasNoTimer" />
                          </MultiBinding>
                        </Button.IsVisible>
                      </Button>
                      <Button Classes="danger-solid icon" Content="■" AutomationProperties.Name="Parar cronômetro"
                              IsVisible="{Binding IsTimerRunning}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).StopTimerCommand}"
                              CommandParameter="{Binding}" />
                      <!-- Mais opções (quantidade e tempo) -->
                      <Button Classes="ghost icon" Content="⋯" AutomationProperties.Name="Mais opções"
                              IsVisible="{Binding !IsCompletion}"
                              Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).OpenPanelCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>

                  <!-- Painel de valor -->
                  <Border Classes="inline-panel" IsVisible="{Binding IsPanelOpen}">
                    <StackPanel Spacing="10">
                      <Border Classes="segment" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton Classes="segment" Content="Adicionar" IsChecked="{Binding PanelAdds}" />
                          <RadioButton Classes="segment" Content="Remover" IsChecked="{Binding PanelRemoves}" />
                        </StackPanel>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsQuantity}">
                        <NumericUpDown Value="{Binding PanelAmountInput}" Minimum="1" Maximum="9999" Increment="1"
                                       FormatString="0" Width="130" AutomationProperties.Name="Quantidade" />
                        <TextBlock Text="{Binding Goal.Unit}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsDuration}">
                        <NumericUpDown Value="{Binding PanelHoursInput}" Minimum="0" Maximum="24" Increment="1"
                                       FormatString="0" Width="110" AutomationProperties.Name="Horas" />
                        <TextBlock Text="h" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding PanelMinutesInput}" Minimum="0" Maximum="59" Increment="5"
                                       FormatString="0" Width="110" AutomationProperties.Name="Minutos" />
                        <TextBlock Text="min" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBox Text="{Binding PanelNote}" MaxLength="200" PlaceholderText="Nota (opcional)"
                               AutomationProperties.Name="Nota" />
                      <TextBlock Classes="field-error" Text="{Binding PanelError}"
                                 IsVisible="{Binding PanelError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Cancelar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).CancelPanelCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="primary" Content="Registrar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).ConfirmPanelCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- Cronômetro parado: conferir e registrar -->
                  <Border Classes="inline-panel" IsVisible="{Binding IsTimerStopped}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Cronômetro parado. Confira o tempo antes de registrar." Foreground="{DynamicResource Muted}" />
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <NumericUpDown Value="{Binding StoppedMinutesInput}" Minimum="0" Maximum="1440" Increment="1"
                                       FormatString="0" Width="130" AutomationProperties.Name="Minutos cronometrados" />
                        <TextBlock Text="min" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBox Text="{Binding PanelNote}" MaxLength="200" PlaceholderText="Nota (opcional)"
                               AutomationProperties.Name="Nota" />
                      <TextBlock Classes="field-error" Text="{Binding PanelError}"
                                 IsVisible="{Binding PanelError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Descartar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).DiscardTimerCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="primary" Content="Registrar"
                                Command="{Binding $parent[ItemsControl].((vm:TodayPageViewModel)DataContext).RegisterTimerCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
