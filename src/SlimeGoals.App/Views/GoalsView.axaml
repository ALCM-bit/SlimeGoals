<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             x:Class="SlimeGoals.App.Views.GoalsView"
             x:DataType="vm:GoalsPageViewModel">
  <Panel>
    <!-- Página de edição no lugar da lista (spec §7: mesma solução no desktop e no celular) -->
    <ContentControl Content="{Binding Editor}"
                    IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <DockPanel Margin="8,4,8,0" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <TextBlock Classes="page-title" Text="{Binding Title}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="primary" Content="Nova meta" Command="{Binding NewCommand}" />
      </Grid>

      <Border DockPanel.Dock="Top" Classes="segment" HorizontalAlignment="Left" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal">
          <RadioButton Classes="segment" GroupName="goals-filter" Content="Ativas"
                       IsChecked="{Binding !ShowArchived, Mode=OneWay}" />
          <RadioButton Classes="segment" GroupName="goals-filter" Content="Arquivadas"
                       IsChecked="{Binding ShowArchived}" />
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Top" Classes="warning-band" Margin="0,0,0,12"
              IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>

      <Panel>
        <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" Foreground="{DynamicResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
        <ScrollViewer IsVisible="{Binding !IsEmpty}">
          <ItemsControl ItemsSource="{Binding Goals}" Margin="0,0,0,14">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GoalItemViewModel">
                <Border Classes="card" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="icon-tile"
                            Background="{Binding Color, Converter={StaticResource GoalColorBrush}, ConverterParameter=Bg}">
                      <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                          <Path Classes="goal-icon" Data="{Binding IconKey, Converter={StaticResource IconGeometry}}"
                                Stroke="{Binding Color, Converter={StaticResource GoalColorBrush}, ConverterParameter=Fg}" />
                        </Canvas>
                      </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Success}" FontSize="12"
                                 IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="ghost" Content="Editar" IsVisible="{Binding !IsArchived}"
                              Command="{Binding $parent[ItemsControl].((vm:GoalsPageViewModel)DataContext).EditCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="ghost" Content="Arquivar" IsVisible="{Binding !IsArchived}"
                              Command="{Binding $parent[ItemsControl].((vm:GoalsPageViewModel)DataContext).ArchiveCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="ghost" Content="Desarquivar" IsVisible="{Binding CanUnarchive}"
                              Command="{Binding $parent[ItemsControl].((vm:GoalsPageViewModel)DataContext).UnarchiveCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </Panel>
</UserControl>
