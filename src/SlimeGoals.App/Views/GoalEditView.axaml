<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             x:Class="SlimeGoals.App.Views.GoalEditView"
             x:DataType="vm:GoalEditViewModel">
  <UserControl.Resources>
    <!-- Barra de ações (erro geral, Excluir, Cancelar, Salvar). Aparece uma vez só: fixa no rodapé no layout largo,
         ou no fim da rolagem no estreito (estilos goal-actions em Controls.axaml). -->
    <DataTemplate x:Key="GoalActions" x:DataType="vm:GoalEditViewModel">
      <StackPanel Spacing="10">
        <Border Classes="warning-band"
                IsVisible="{Binding GeneralError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding GeneralError}" TextWrapping="Wrap" />
        </Border>
        <!-- No layout estreito, Excluir (e a confirmação) desce para a linha de baixo (estilo delete-actions) -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel Classes="delete-actions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="danger" Content="Excluir" Command="{Binding DeleteCommand}"
                    IsVisible="{Binding !IsNew}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingDelete}">
              <TextBlock Text="Excluir esta meta?" VerticalAlignment="Center" Foreground="{DynamicResource Warning}" />
              <Button Classes="ghost" Content="Cancelar" Command="{Binding CancelDeleteCommand}" />
              <Button Classes="danger-solid" Content="Excluir" Command="{Binding ConfirmDeleteCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Content="Cancelar" Command="{Binding CancelCommand}" />
            <Button Classes="primary save" Content="Salvar" Command="{Binding SaveCommand}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Classes="page">
    <!-- Cabeçalho: voltar = cancelar -->
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <Button Classes="ghost back" Content="← Metas" Command="{Binding CancelCommand}" HorizontalAlignment="Left" />
      <TextBlock Classes="page-title" Text="{Binding PageTitle}" />
    </StackPanel>

    <!-- Rodapé fixo com as ações (layout largo) -->
    <ContentControl DockPanel.Dock="Bottom" Classes="goal-actions docked" Content="{Binding}"
                    ContentTemplate="{StaticResource GoalActions}" />

    <ScrollViewer>
      <StackPanel Classes="goal-form" Margin="0,0,0,8">
        <StackPanel Spacing="18">

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="Título" />
            <TextBox Text="{Binding Title}" MaxLength="80" PlaceholderText="Ex.: Estudar inglês"
                     AutomationProperties.Name="Título" />
            <TextBlock Classes="field-error" Text="{Binding TitleError}"
                       IsVisible="{Binding TitleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="Tipo" />
            <Border Classes="segment" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="segment" GroupName="goal-type" Content="Diária" IsChecked="{Binding IsDaily}" />
                <RadioButton Classes="segment" GroupName="goal-type" Content="Semanal" IsChecked="{Binding IsWeekly}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="Medida" />
            <Border Classes="segment" HorizontalAlignment="Left" IsEnabled="{Binding !IsMeasureLocked}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="segment" GroupName="goal-measure" Content="Conclusão" IsChecked="{Binding IsCompletion}" />
                <RadioButton Classes="segment" GroupName="goal-measure" Content="Quantidade" IsChecked="{Binding IsQuantity}" />
                <RadioButton Classes="segment" GroupName="goal-measure" Content="Tempo" IsChecked="{Binding IsDuration}" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding MeasureLockedHint}" Foreground="{DynamicResource Muted}" FontSize="12"
                       IsVisible="{Binding IsMeasureLocked}" />
            <TextBlock Classes="field-error" Text="{Binding MeasureError}"
                       IsVisible="{Binding MeasureError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Classes="field" IsVisible="{Binding IsQuantity}">
            <TextBlock Classes="field-label" Text="Alvo" />
            <StackPanel Classes="field-row">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <NumericUpDown Value="{Binding TargetInput}" Minimum="1" Maximum="9999" Increment="1" FormatString="0"
                               Width="130" AutomationProperties.Name="Alvo" />
                <TextBox Text="{Binding Unit}" MaxLength="20" Width="150" PlaceholderText="Ex.: copos"
                         AutomationProperties.Name="Unidade" />
              </StackPanel>
              <TextBlock Text="{Binding TargetSuffix}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
            </StackPanel>
            <TextBlock Classes="field-error" Text="{Binding TargetError}"
                       IsVisible="{Binding TargetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="field-error" Text="{Binding UnitError}"
                       IsVisible="{Binding UnitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Classes="field" IsVisible="{Binding IsDuration}">
            <TextBlock Classes="field-label" Text="Alvo" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <NumericUpDown Value="{Binding DurationHoursInput}" Minimum="0" Maximum="168" Increment="1" FormatString="0"
                             Width="110" AutomationProperties.Name="Horas" />
              <TextBlock Text="h" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding DurationMinutesInput}" Minimum="0" Maximum="59" Increment="1" FormatString="0"
                             Width="110" AutomationProperties.Name="Minutos" />
              <TextBlock Text="min" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TargetSuffix}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
            </StackPanel>
            <TextBlock Classes="field-error" Text="{Binding TargetError}"
                       IsVisible="{Binding TargetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="Ícone" />
            <ListBox Classes="icon-picker" ItemsSource="{Binding Icons}" SelectedItem="{Binding SelectedIcon}"
                     SelectionMode="Single,AlwaysSelected" AutomationProperties.Name="Ícone">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:IconOption">
                  <Viewbox Width="22" Height="22" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                    <Canvas Width="24" Height="24">
                      <Path Classes="goal-icon" Stroke="{DynamicResource PrimaryTint}"
                            Data="{Binding Key, Converter={StaticResource IconGeometry}}" />
                    </Canvas>
                  </Viewbox>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="Cor" />
            <ListBox Classes="color-picker" ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}"
                     SelectionMode="Single,AlwaysSelected" AutomationProperties.Name="Cor">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ColorOption">
                  <Ellipse Width="28" Height="28" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                           Fill="{Binding Color, Converter={StaticResource GoalColorBrush}, ConverterParameter=Fg}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="Lembrar a cada" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <NumericUpDown Value="{Binding ReminderHoursInput}" Minimum="0" Maximum="24" Increment="1" FormatString="0"
                             Width="110" AutomationProperties.Name="Lembrar a cada, horas" />
              <TextBlock Text="h" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding ReminderMinutesInput}" Minimum="0" Maximum="59" Increment="1" FormatString="0"
                             Width="110" AutomationProperties.Name="Lembrar a cada, minutos" />
              <TextBlock Text="min" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="field-error" Text="{Binding ReminderError}"
                       IsVisible="{Binding ReminderError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="Horário dos lembretes" />
            <StackPanel Classes="field-row">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="row-label" Text="Das" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                <TimePicker SelectedTime="{Binding ActiveFrom}" ClockIdentifier="24HourClock" MinuteIncrement="5"
                            AutomationProperties.Name="Início do horário" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="row-label" Text="às" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                <TimePicker SelectedTime="{Binding ActiveUntil}" ClockIdentifier="24HourClock" MinuteIncrement="5"
                            AutomationProperties.Name="Fim do horário" />
              </StackPanel>
            </StackPanel>
            <TextBlock Classes="field-error" Text="{Binding ActiveFromError}"
                       IsVisible="{Binding ActiveFromError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="field-error" Text="{Binding ActiveUntilError}"
                       IsVisible="{Binding ActiveUntilError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="Dias" />
            <ItemsControl ItemsSource="{Binding Days}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DayOption">
                  <ToggleButton Classes="day" Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="field-error" Text="{Binding ActiveDaysError}"
                       IsVisible="{Binding ActiveDaysError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Classes="field">
            <TextBlock Classes="field-label" Text="Período (opcional)" />
            <StackPanel Classes="field-row">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="row-label" Text="Início" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                <CalendarDatePicker SelectedDate="{Binding StartDate}" SelectedDateFormat="Custom"
                                    CustomDateFormatString="dd/MM/yyyy" PlaceholderText="Sem início" Width="150"
                                    AutomationProperties.Name="Data de início" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="row-label" Text="Fim" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                <CalendarDatePicker SelectedDate="{Binding EndDate}" SelectedDateFormat="Custom"
                                    CustomDateFormatString="dd/MM/yyyy" PlaceholderText="Sem fim" Width="150"
                                    AutomationProperties.Name="Data de fim" />
              </StackPanel>
            </StackPanel>
            <TextBlock Classes="field-error" Text="{Binding EndDateError}"
                       IsVisible="{Binding EndDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>
        <!-- Ações no fim da rolagem (layout estreito) -->
        <ContentControl Classes="goal-actions inline" Content="{Binding}" ContentTemplate="{StaticResource GoalActions}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
