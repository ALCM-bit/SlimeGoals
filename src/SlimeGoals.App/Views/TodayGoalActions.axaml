<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:SlimeGoals.App.Views"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             x:Class="SlimeGoals.App.Views.TodayGoalActions"
             x:DataType="vm:TodayGoalViewModel">
  <!-- Botões por medida da meta de hoje (conclusão, quantidade, tempo), com o tempo corrido ao lado na tela larga.
       Usado pelo cartão (celular) e pela linha (desktop). -->
  <!-- Sem Spacing: cada botão leva 8 px à esquerda (a margem negativa do painel anula a do primeiro). Assim a vaga do
       "⋯" que sobra vazia não ocupa espaço, e o botão principal fica na mesma ponta em todas as linhas -->
  <StackPanel Orientation="Horizontal" Margin="-8,0,0,0" VerticalAlignment="Center">
    <!-- Conclusão -->
    <Button Classes="ghost icon" Margin="8,0,0,0" AutomationProperties.Name="Desmarcar" ToolTip.Tip="Desmarcar"
            IsVisible="{Binding IsCompletion}" IsEnabled="{Binding IsMet}"
            Command="{Binding $parent[views:TodayView].((vm:TodayPageViewModel)DataContext).UncompleteCommand}"
            CommandParameter="{Binding}">
      <Path Classes="btn-icon" Data="{StaticResource IconX}" />
    </Button>
    <Button Classes="primary icon" Margin="8,0,0,0" AutomationProperties.Name="Feito" ToolTip.Tip="Marcar como feito"
            IsVisible="{Binding IsCompletion}" IsEnabled="{Binding !IsMet}"
            Command="{Binding $parent[views:TodayView].((vm:TodayPageViewModel)DataContext).CompleteCommand}"
            CommandParameter="{Binding}">
      <Path Classes="btn-icon" Data="{StaticResource IconCheck}" />
    </Button>
    <!-- Quantidade -->
    <Button Classes="ghost icon" Margin="8,0,0,0" IsVisible="{Binding IsQuantity}"
            AutomationProperties.Name="Remover 1" ToolTip.Tip="Remover 1"
            Command="{Binding $parent[views:TodayView].((vm:TodayPageViewModel)DataContext).DecrementCommand}"
            CommandParameter="{Binding}">
      <Path Classes="btn-icon" Data="{StaticResource IconMinus}" />
    </Button>
    <Button Classes="primary icon" Margin="8,0,0,0" IsVisible="{Binding IsQuantity}"
            AutomationProperties.Name="Adicionar 1" ToolTip.Tip="Adicionar 1"
            Command="{Binding $parent[views:TodayView].((vm:TodayPageViewModel)DataContext).IncrementCommand}"
            CommandParameter="{Binding}">
      <Path Classes="btn-icon" Data="{StaticResource IconPlus}" />
    </Button>
    <!-- Tempo -->
    <TextBlock Margin="8,0,0,0" Classes="elapsed wide" Classes.running="{Binding IsTimerRunning}" Text="{Binding Elapsed}" />
    <!-- Na linha do desktop o "⋯" vem antes do botão principal, que fica na ponta como no mockup (decisão 18) -->
    <Panel Classes="row-only">
      <Button Classes="ghost icon" Margin="8,0,0,0" AutomationProperties.Name="Lançar tempo" ToolTip.Tip="Lançar ou remover tempo"
              IsVisible="{Binding IsDuration}"
              Command="{Binding $parent[views:TodayView].((vm:TodayPageViewModel)DataContext).OpenPanelCommand}"
              CommandParameter="{Binding}">
        <Path Classes="btn-icon" Data="{StaticResource IconEllipsis}" />
      </Button>
    </Panel>
    <Button Classes="primary icon" Margin="8,0,0,0" AutomationProperties.Name="Iniciar cronômetro" ToolTip.Tip="Iniciar cronômetro"
            IsEnabled="{Binding CanStartTimer}"
            Command="{Binding $parent[views:TodayView].((vm:TodayPageViewModel)DataContext).StartTimerCommand}"
            CommandParameter="{Binding}">
      <Button.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsDuration" />
          <Binding Path="HasNoTimer" />
        </MultiBinding>
      </Button.IsVisible>
      <Path Classes="btn-icon" Data="{StaticResource IconPlay}" />
    </Button>
    <!-- No modo de troca, Trocar e Cancelar ocupam o lugar de ⇄ e ■ (abaixo do campo) -->
    <Button Classes="danger-solid icon" Margin="8,0,0,0" AutomationProperties.Name="Parar cronômetro" ToolTip.Tip="Parar cronômetro"
            Command="{Binding $parent[views:TodayView].((vm:TodayPageViewModel)DataContext).StopTimerCommand}"
            CommandParameter="{Binding}">
      <Button.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsTimerRunning" />
          <Binding Path="!IsSwitchingTask" />
        </MultiBinding>
      </Button.IsVisible>
      <Path Classes="btn-icon" Data="{StaticResource IconStop}" />
    </Button>
    <!-- Mais opções (só tempo), no cartão do celular -->
    <Panel Classes="card-only">
      <Button Classes="ghost icon" Margin="8,0,0,0" AutomationProperties.Name="Lançar tempo" ToolTip.Tip="Lançar ou remover tempo"
              IsVisible="{Binding IsDuration}"
              Command="{Binding $parent[views:TodayView].((vm:TodayPageViewModel)DataContext).OpenPanelCommand}"
              CommandParameter="{Binding}">
        <Path Classes="btn-icon" Data="{StaticResource IconEllipsis}" />
      </Button>
    </Panel>
  </StackPanel>
</UserControl>
