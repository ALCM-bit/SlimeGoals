<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             xmlns:about="using:SlimeGoals.App.About"
             xmlns:views="using:SlimeGoals.App.Views"
             x:Class="SlimeGoals.App.Views.SettingsView"
             x:DataType="vm:SettingsPageViewModel">
  <DockPanel Classes="page">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <!-- Voltar: um nível por vez (texto da licença → lista → Sobre → grupos; tela da conta → Sincronização → grupos) -->
      <Button Classes="ghost back" Content="← Configurações" Command="{Binding CloseSectionCommand}"
              HorizontalAlignment="Left" IsVisible="{Binding IsSectionOpen}" />
      <Button Classes="ghost back" Content="← Sobre" Command="{Binding CloseLicensesCommand}"
              HorizontalAlignment="Left" IsVisible="{Binding IsLicenseListOpen}" />
      <Button Classes="ghost back" Content="← Licenças" Command="{Binding CloseLicenseTextCommand}"
              HorizontalAlignment="Left" IsVisible="{Binding IsLicenseTextOpen}" />
      <!-- Subpágina da conta: o Voltar fica parado enquanto ocupado e até guardar o código de recuperação -->
      <Button Classes="ghost back" Content="← Sincronização" Command="{Binding Account.CloseCommand, FallbackValue={x:Null}}"
              HorizontalAlignment="Left" IsVisible="{Binding IsAccountPageOpen}" />
      <TextBlock Classes="page-title" Text="{Binding HeaderTitle}" IsVisible="{Binding IsMainOpen}" />
      <TextBlock Classes="page-title" Text="{Binding HeaderTitle}" IsVisible="{Binding IsSectionOpen}" />
      <TextBlock Classes="page-title" Text="Licenças" IsVisible="{Binding IsLicenseListOpen}" />
      <TextBlock Classes="page-title" Text="{Binding SelectedLicense.Component}" TextWrapping="Wrap"
                 IsVisible="{Binding IsLicenseTextOpen}" />
      <TextBlock Classes="page-title" Text="{Binding Account.PageTitle, FallbackValue={x:Null}}" TextWrapping="Wrap"
                 IsVisible="{Binding IsAccountPageOpen}" />
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="warning-band" Margin="0,0,0,12"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </Border>

    <Panel>
      <!-- Lista de grupos: cada linha mostra o estado atual e abre a página do grupo -->
      <ScrollViewer Classes="page" IsVisible="{Binding IsMainOpen}">
        <views:FillWidthStackPanel Classes="settings-list" Spacing="10" Margin="0,0,0,14">
          <Border Classes="card" IsVisible="{Binding IsEmpty}">
            <TextBlock Text="{Binding EmptyMessage}"
                       Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
          </Border>
          <Button Classes="nav-row" IsVisible="{Binding ShowAccount}" Command="{Binding OpenSectionCommand}"
                  CommandParameter="{x:Static vm:SettingsSection.Sync}" AutomationProperties.Name="Sincronização">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="nav-row-title" Text="Sincronização" />
                <TextBlock Classes="nav-row-summary" Text="{Binding Account.SummaryText, FallbackValue={x:Null}}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="nav-row-chevron" Text="›" />
            </Grid>
          </Button>
          <Button Classes="nav-row" IsVisible="{Binding ShowReminders}" Command="{Binding OpenSectionCommand}"
                  CommandParameter="{x:Static vm:SettingsSection.Reminders}" AutomationProperties.Name="Lembretes">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="nav-row-title" Text="Lembretes" />
                <TextBlock Classes="nav-row-summary" Text="{Binding RemindersSummary}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="nav-row-chevron" Text="›" />
            </Grid>
          </Button>
          <Button Classes="nav-row" IsVisible="{Binding ShowWindow}" Command="{Binding OpenSectionCommand}"
                  CommandParameter="{x:Static vm:SettingsSection.Window}" AutomationProperties.Name="Janela">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="nav-row-title" Text="Janela" />
                <TextBlock Classes="nav-row-summary" Text="{Binding WindowSummary}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="nav-row-chevron" Text="›" />
            </Grid>
          </Button>
          <Button Classes="nav-row" IsVisible="{Binding ShowGeneral}" Command="{Binding OpenSectionCommand}"
                  CommandParameter="{x:Static vm:SettingsSection.General}" AutomationProperties.Name="Geral">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="nav-row-title" Text="Geral" />
                <TextBlock Classes="nav-row-summary" Text="{Binding GeneralSummary}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="nav-row-chevron" Text="›" />
            </Grid>
          </Button>
          <Button Classes="nav-row" Command="{Binding OpenSectionCommand}"
                  CommandParameter="{x:Static vm:SettingsSection.About}" AutomationProperties.Name="Sobre">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="nav-row-title" Text="Sobre" />
                <TextBlock Classes="nav-row-summary" Text="{Binding VersionText}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="nav-row-chevron" Text="›" />
            </Grid>
          </Button>
        </views:FillWidthStackPanel>
      </ScrollViewer>

      <!-- Sincronização -->
      <ScrollViewer Classes="page" IsVisible="{Binding IsSyncOpen}">
        <views:FillWidthStackPanel Classes="settings-list" Margin="0,0,0,14">
          <views:AccountSectionView DataContext="{Binding Account}" />
        </views:FillWidthStackPanel>
      </ScrollViewer>

      <ScrollViewer Classes="page" IsVisible="{Binding IsRemindersOpen}">
        <views:FillWidthStackPanel Classes="settings-list" Margin="0,0,0,14">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="Adiar lembretes por" />
              <ComboBox MinHeight="44" MinWidth="160" HorizontalAlignment="Left" ItemsSource="{Binding SnoozeOptions}"
                        SelectedItem="{Binding SelectedSnooze}" AutomationProperties.Name="Adiar lembretes por">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SnoozeOptionViewModel">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MinHeight="44" IsVisible="{Binding ShowPermissions}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Notificações" />
                  <TextBlock Text="{Binding NotificationsText}" Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" MinHeight="44" Content="Permitir"
                        IsVisible="{Binding CanRequestNotifications}" Command="{Binding RequestNotificationsCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MinHeight="44" IsVisible="{Binding ShowPermissions}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Alarmes exatos" />
                  <TextBlock Text="{Binding ExactAlarmsText}" Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" MinHeight="44" Content="Permitir"
                        IsVisible="{Binding CanRequestExactAlarms}" Command="{Binding RequestExactAlarmsCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MinHeight="44" IsVisible="{Binding ShowPermissions}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Bateria" />
                  <TextBlock Text="{Binding BatteryText}" Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" MinHeight="44" Content="Liberar"
                        IsVisible="{Binding CanRequestBattery}" Command="{Binding RequestBatteryCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </views:FillWidthStackPanel>
      </ScrollViewer>

      <ScrollViewer Classes="page" IsVisible="{Binding IsWindowOpen}">
        <views:FillWidthStackPanel Classes="settings-list" Margin="0,0,0,14">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="Ao fechar a janela" />
              <Border Classes="segment" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="close-action" Content="Manter em segundo plano"
                               IsChecked="{Binding CloseHides}" />
                  <RadioButton Classes="segment" GroupName="close-action" Content="Encerrar o app"
                               IsChecked="{Binding CloseQuits}" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding CloseHint}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </views:FillWidthStackPanel>
      </ScrollViewer>

      <ScrollViewer Classes="page" IsVisible="{Binding IsGeneralOpen}">
        <views:FillWidthStackPanel Classes="settings-list" Margin="0,0,0,14">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <ToggleSwitch MinHeight="44" Content="Iniciar com o sistema" OnContent="" OffContent="" IsChecked="{Binding StartWithSystem}"
                            IsEnabled="{Binding CanAutostart}" />
              <TextBlock Text="Abre em segundo plano ao entrar na sessão." Foreground="{DynamicResource Muted}"
                         TextWrapping="Wrap" IsVisible="{Binding CanAutostart}" />
              <TextBlock Text="{Binding AutostartUnavailableText}" Foreground="{DynamicResource Muted}"
                         TextWrapping="Wrap" IsVisible="{Binding !CanAutostart}" />
            </StackPanel>
          </Border>
        </views:FillWidthStackPanel>
      </ScrollViewer>

      <ScrollViewer Classes="page" IsVisible="{Binding IsAboutOpen}">
        <views:FillWidthStackPanel Classes="settings-list" Margin="0,0,0,14">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding VersionText}" />
              <TextBlock Text="{Binding LicenseText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
              <Button Classes="ghost" MinHeight="44" HorizontalAlignment="Left" Content="Licenças"
                      Command="{Binding OpenLicensesCommand}" />
            </StackPanel>
          </Border>
        </views:FillWidthStackPanel>
      </ScrollViewer>

      <!-- Subpáginas da conta -->
      <Panel IsVisible="{Binding IsAccountPageOpen}">
        <views:AccountView DataContext="{Binding Account}" />
      </Panel>

      <!-- Lista de licenças -->
      <ScrollViewer Classes="page" IsVisible="{Binding IsLicenseListOpen}">
        <ItemsControl ItemsSource="{Binding Licenses}" Margin="0,0,0,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="about:LicenseEntry">
              <Button Classes="ghost" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding $parent[ItemsControl].((vm:SettingsPageViewModel)DataContext).SelectLicenseCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding Component}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding License}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Where}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Texto da licença -->
      <ScrollViewer x:Name="LicenseTextScroller" Classes="page" IsVisible="{Binding IsLicenseTextOpen}">
        <SelectableTextBlock Text="{Binding SelectedLicenseText}" TextWrapping="Wrap" FontFamily="monospace"
                             FontSize="12" Margin="0,0,0,14" />
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
