<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             xmlns:views="using:SlimeGoals.App.Views"
             x:Class="SlimeGoals.App.Views.TimeView"
             x:DataType="vm:TimePageViewModel">
  <!-- Aba Tempo (spec Pomodoro §4 e §6): o título no lugar do das outras páginas; as subabas e o Pomodoro numa coluna
       que, no desktop, fica centrada, com 560 px no máximo (estilo focus-column). -->
  <Panel>
    <!-- "Criar uma meta com ele": o editor de meta no lugar da página, como em Metas -->
    <ContentControl Content="{Binding Pomodoro.Editor}"
                    IsVisible="{Binding Pomodoro.Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <DockPanel Classes="page" IsVisible="{Binding Pomodoro.Editor, Converter={x:Static ObjectConverters.IsNull}}">
      <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
        <TextBlock Classes="page-title" Text="{Binding Title}" />
        <!-- Subabas: por enquanto só o Pomodoro, num selo sozinho (um segmento de uma opção pareceria um botão). Com a
             sessão aberta não há o que trocar, e a altura vai para o relógio -->
        <ItemsControl Classes="focus-column" ItemsSource="{Binding Tabs}" AutomationProperties.Name="Métodos"
                      IsVisible="{Binding Pomodoro.IsPreparing}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Classes="method-tab">
                <TextBlock Text="{Binding}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <views:PomodoroView DataContext="{Binding Pomodoro}" />
    </DockPanel>
  </Panel>
</UserControl>
