<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeGoals.App.ViewModels"
             xmlns:conv="using:SlimeGoals.App.Converters"
             xmlns:views="using:SlimeGoals.App.Views"
             x:Class="SlimeGoals.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <!-- Largo (desktop): barra lateral de 224px encostada na borda + conteúdo (decisão 18).
       Estreito (classe compact, abaixo de 720px; ver code-behind): navegação inferior, sem barra lateral. -->
  <DockPanel x:Name="Root">
    <Border DockPanel.Dock="Bottom" Classes="bottom-nav">
      <ListBox Classes="bottom-nav" ItemsSource="{Binding Pages}" SelectionMode="Single,AlwaysSelected"
               SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
               AutomationProperties.Name="Navegação principal">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PageViewModel">
            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Classes="nav-pill">
                <Viewbox Width="22" Height="22">
                  <Canvas Width="24" Height="24">
                    <Path Classes="nav-icon" Data="{Binding IconKey, Converter={x:Static conv:NavIconConverter.Instance}}" />
                  </Canvas>
                </Viewbox>
              </Border>
              <!-- Na barra de baixo cabem cinco rótulos a 320 px: o curto ("Config."); a lateral mantém o inteiro -->
              <TextBlock Classes="nav-label" Text="{Binding ShortTitle}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <DockPanel Classes="shell-body">
      <!-- Barra lateral do desktop (decisão 18): encostada na borda; slime e nome no topo, páginas com ícone,
           no rodapé "Recolher menu" e "Sair", este abaixo de uma divisória. Recolhida (classe collapsed, decisão 23),
           só os ícones, com o nome da página na dica -->
      <Border DockPanel.Dock="Left" Classes="sidebar" Classes.collapsed="{Binding IsSidebarCollapsed}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Classes="sidebar-brand" Orientation="Horizontal" Spacing="10">
            <views:SlimeMascot Width="44" Height="44" Pose="Happy" IsStill="True" IsHitTestVisible="False" />
            <TextBlock Classes="sidebar-label" Text="SlimeGoals" FontSize="21" FontWeight="ExtraBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <!-- Aberta: ícone de recolher e "Recolher menu"; recolhida: só o ícone de abrir (decisão 23) -->
            <Button Classes="sidebar-action" Command="{Binding ToggleSidebarCommand}" Margin="0,0,0,8"
                    ToolTip.Tip="{Binding SidebarToggleText}" AutomationProperties.Name="{Binding SidebarToggleText}">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Viewbox Width="22" Height="22">
                  <Canvas Width="24" Height="24">
                    <Path Classes="sidebar-icon" Data="{StaticResource IconPanelLeftClose}" IsVisible="{Binding !IsSidebarCollapsed}" />
                    <Path Classes="sidebar-icon" Data="{StaticResource IconPanelLeftOpen}" IsVisible="{Binding IsSidebarCollapsed}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Classes="sidebar-label" Text="Recolher menu" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel IsVisible="{Binding ShowQuit}">
              <Border Classes="sidebar-divider" />
              <Button Classes="sidebar-action" Command="{Binding QuitCommand}" ToolTip.Tip="Sair (Ctrl+Q)"
                      AutomationProperties.Name="Sair">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                      <Path Classes="sidebar-icon" Data="{StaticResource IconLogout}" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Classes="sidebar-label" Text="Sair" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectionMode="Single,AlwaysSelected"
                   SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                   AutomationProperties.Name="Navegação principal">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PageViewModel">
                <StackPanel Orientation="Horizontal" Spacing="16" Background="Transparent"
                            ToolTip.Tip="{Binding Title}"
                            ToolTip.ServiceEnabled="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).IsSidebarCollapsed}">
                  <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                      <Path Classes="nav-icon" Data="{Binding IconKey, Converter={x:Static conv:NavIconConverter.Instance}, ConverterParameter=Side}" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Classes="sidebar-label" Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
  </DockPanel>
</UserControl>
