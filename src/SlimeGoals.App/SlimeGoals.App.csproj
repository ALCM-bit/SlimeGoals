<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Textos de licença embutidos: a tela "Sobre" os lê e o pacote do Linux os copia para licenses/. -->
  <ItemGroup>
    <EmbeddedResource Include="Licenses\*.txt" LogicalName="SlimeGoals.Licenses.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\LICENSE.md" Link="Licenses\LICENSE.md" LogicalName="SlimeGoals.Licenses.LICENSE.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlimeGoals.Core\SlimeGoals.Core.csproj" />
    <!-- A tela da conta precisa dos tipos de erro e do cadastro pendente (decisão 4 da 9.5a). -->
    <ProjectReference Include="..\SlimeGoals.Sync\SlimeGoals.Sync.csproj" />
  </ItemGroup>

</Project>
